# ---------------------------------------------------------------------------
# CHIP — configuration. Copy to .env.local. Everything NEXT_PUBLIC_* ships to
# the browser; keep keys out of it.
# ---------------------------------------------------------------------------

# Robinhood Chain (defaults shown).
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RPC_FALLBACKS=https://robinhood-rpc.publicnode.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# CONFIGURE — the CHIP ERC-20 (a Pons V2 launch) and the reserve wallet that
# receives routed fees and holds the NVDA Stock Tokens. LIVE mode is offered
# only when both are set; until then the site runs in DEMO mode.
NEXT_PUBLIC_CHIP_TOKEN=
NEXT_PUBLIC_RESERVE_WALLET=
# First block to scan for NVDA inflows to the reserve (set it: scanning from 0 is slow).
NEXT_PUBLIC_RESERVE_START_BLOCK=0

# Optional, listed under VERIFY THE CORE when set.
NEXT_PUBLIC_EXECUTION_CONTRACT=
NEXT_PUBLIC_ROUTING_CONTRACT=

# VERIFIED — NVIDIA • Robinhood Token (NVDA), 18 decimals. Override only if it moves.
NEXT_PUBLIC_NVDA_TOKEN=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC

# The core input, in USD, at which an NVDA execution becomes eligible.
NEXT_PUBLIC_TARGET_INPUT_USD=1000

# Where TRADE CHIP goes. Defaults to the Pons page of the token.
NEXT_PUBLIC_TRADE_URL=

# WalletConnect Cloud project id (mobile wallets). Injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Site
NEXT_PUBLIC_SITE_URL=https://chip.example
NEXT_PUBLIC_TWITTER_URL=https://x.com/Chip_nvid

# Server only — Pyth Hermes (best price source). Without it the server falls
# back to Yahoo Finance (delayed) and then to Pyth on-chain (can be stale).
PYTH_API_KEY=
PYTH_HERMES_URL=https://hermes.pyth.network
